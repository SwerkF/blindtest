DATABASE_URL="file:./dev.db"

# Optional Discord accounts (history, achievements, friends). Leave the Discord
# values empty to run guest-only: the "Se connecter avec Discord" button is hidden.
# Create an application at https://discord.com/developers/applications, OAuth2 tab,
# and add the redirect URI below (the web app proxies /api to the server).
# Docker Compose reads this file as the root .env; for `bun dev` put them in apps/server/.env.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Production: https://blindtest.oliwr.win/api/auth/discord/callback
DISCORD_REDIRECT_URI="http://localhost:5173/api/auth/discord/callback"
# Signs the session cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=""
# Public URL of the web app, used for post-login redirects, CORS and Secure cookies.
# Production: https://blindtest.oliwr.win
WEB_ORIGIN="http://localhost:5173"

# Optional: Discord id of "Swerk" for the secret achievements (defaults to the real one).
# SWERK_DISCORD_ID=""

# Optional "Donner un retour" button: creates an issue in an It's a Plan project (https://kanban.oliwr.win).
# Leave these empty (or any required one missing) to hide the button; POST /feedback then answers 503.
ITSAPLAN_URL=""
ITSAPLAN_API_KEY=""
ITSAPLAN_PROJECT_KEY=""
# Issue type ids of the project: bug, idea, other
ITSAPLAN_TYPE_BUG=""
ITSAPLAN_TYPE_IDEE=""
ITSAPLAN_TYPE_AUTRE=""
# Optional: start column and label added to every player feedback
ITSAPLAN_COLUMN_ID=""
ITSAPLAN_LABEL_FEEDBACK=""
