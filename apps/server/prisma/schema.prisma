generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Playlist {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  deezerPlaylistId String
  description      String?
  coverUrl         String?
  trackCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
}
