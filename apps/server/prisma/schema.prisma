generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Playlist {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  deezerPlaylistId String
  description      String?
  coverUrl         String?
  trackCount       Int      @default(0)
  /// Matches a GameMode: "classic" or "anime".
  category         String   @default("classic")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
}

/// Optional account, created on the first Discord login. Guests never get one.
model User {
  id            String   @id @default(cuid())
  discordId     String   @unique
  username      String
  /// Discord avatar hash, null when the user kept the default one.
  discordAvatar String?
  /// Pseudo and Blobatar seed synced with the local profile of the web app.
  pseudo        String?
  avatarSeed    String?
  /// Shows the Discord profile picture instead of the Blobatar.
  useDiscordAvatar Boolean @default(false)
  friendCode    String   @unique
  /// Packs opened since the last legendary vinyl (pity timer, see booster/open.ts).
  packsSincePity Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  results          GameResult[]
  achievements     UserAchievement[]
  sentRequests     Friendship[]      @relation("FriendshipRequester")
  receivedRequests Friendship[]      @relation("FriendshipAddressee")
  packs            UserPack[]
  cards            UserCard[]
}

/// Login session; the cookie carries its id signed with SESSION_SECRET.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// One finished game as seen by one logged-in participant.
model GameResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomCode    String
  mode        String
  score       Int
  rank        Int
  playerCount Int
  roundCount  Int
  won         Boolean
  team        String?
  teamWon     Boolean?
  /// Round detail for profile stats (see account/stats.ts). Games saved before
  /// it was tracked keep roundsTracked = 0 and are left out of round stats.
  roundsTracked    Int @default(0)
  artistFound      Int @default(0)
  titleFound       Int @default(0)
  yearFound        Int @default(0)
  /// Rounds with both the artist and the title.
  perfectRounds    Int @default(0)
  /// Rounds with the artist, the title and the year.
  ultimateRounds   Int @default(0)
  /// Sum and count of the times to find the title, for the average.
  titleTimeTotalMs Int @default(0)
  titleTimeCount   Int @default(0)
  playedAt    DateTime @default(now())

  @@index([userId, playedAt])
}

model UserAchievement {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime @default(now())

  @@id([userId, achievementId])
}

/// A single row per pair: "pending" until the addressee accepts it.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

/// One playable track that vinyl packs can draw. Built by the quarterly catalogue
/// script (scripts/catalog), never in live. Images are not stored: the cover is
/// rebuilt from deezerMd5Image and loaded by the browser from the Deezer CDN.
model CardPoolEntry {
  id              String   @id @default(cuid())
  isrc            String   @unique
  recordingMbid   String?
  /// Null until the track is resolved on Deezer, lazily, when a pack containing it is opened.
  deezerTrackId   BigInt?  @unique
  title           String
  artistName      String
  deezerMd5Image  String?
  /// When deezerTrackId / deezerMd5Image were resolved on Deezer.
  resolvedAt      DateTime?
  /// Deezer has no readable preview for this ISRC: never drawn again.
  unplayable      Boolean  @default(false)
  /// Matches a CardRarity; only used to draw. Owned vinyls keep UserCard.rarityAtObtain.
  rarity          String
  popularityScore Float
  /// JSON array of the thematic pools (genre, decade) the track belongs to.
  pools           String   @default("[]")
  /// False once the track left the catalogue; entries are never deleted.
  available       Boolean  @default(true)
  /// Set when a client could not load the cover, so the next script run refreshes it.
  needsRefresh    Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  cards UserCard[]

  @@index([available, unplayable, rarity])
}

/// A pack earned by a player; it stays in the table once opened (openedAt) so the
/// daily cap can count what was earned and an opening is a conditional update.
model UserPack {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Matches a PackRarity.
  rarity       String
  earnedAt     DateTime @default(now())
  /// Null while the pack sits unopened in the inventory.
  openedAt     DateTime?
  /// At most one pack per game result, which makes granting idempotent.
  gameResultId String?  @unique

  @@index([userId, openedAt, rarity])
  @@index([userId, earnedAt])
}

/// A vinyl in a player's collection; duplicates only raise the count.
model UserCard {
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId         String
  entry           CardPoolEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  /// Rarity frozen the first time the vinyl was drawn; collections only use this one.
  rarityAtObtain  String
  count           Int           @default(1)
  firstObtainedAt DateTime      @default(now())
  lastObtainedAt  DateTime      @default(now())

  @@id([userId, entryId])
  @@index([entryId])
  @@index([userId, rarityAtObtain])
}
